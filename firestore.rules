rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRule() {
      let data = getUserData();
      return data.rule != null ? data.rule : (data.role != null ? data.role : '');
    }

    function isAdmin() {
      return isSignedIn() && (getUserRule() == 'admin');
    }

    // ===== runs collection =====
    // Anyone can read (public view), only admin can add/edit/delete
    match /runs/{runId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ===== players collection =====
    // Anyone can read, only admin can add/edit/delete
    match /players/{playerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ===== users collection =====
    // Any signed-in user can read all users and create/update their own profile
    // Only admin can change rule or role of another user
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (
        isAdmin() || 
        (request.auth.uid == userId && 
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rule', 'role']))
      );
      allow delete: if isAdmin();
    }

    // ===== logs collection =====
    // Signed-in users can write logs; cannot edit or delete history
    match /logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}
