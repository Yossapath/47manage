rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== HELPER FUNCTIONS =====
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && getUserRole() == 'admin';
    }

    function isMember() {
      return isSignedIn() && (getUserRole() == 'member' || getUserRole() == 'admin');
    }

    // ===== runs collection =====
    // Anyone can read (public view), only admin can write
    match /runs/{runId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ===== players collection =====
    // Anyone can read, only admin can write
    match /players/{playerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ===== users collection =====
    // Users can read their own doc, admin can read all
    // Users can create their own doc (on register)
    // Only admin can change 'role' field
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId
                    && request.resource.data.role == 'member';  // force role=member on register
      allow update: if isAdmin();  // only admin can update (including role changes)
      allow delete: if isAdmin();
    }
  }
}
